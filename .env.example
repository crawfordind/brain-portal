# ===========================================
# Brain Portal - Environment Variables
# ===========================================
# Copy this file to .env.local for development
# For Vercel: Add these in your project settings
# ===========================================

# Database (Turso - Required)
# ---------------------------
# 1. Create database: turso db create brain-portal
# 2. Get URL: turso db show brain-portal --url
# 3. Create token: turso db tokens create brain-portal
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# AI Provider (OpenRouter - Required)
# ------------------------------------
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=x-ai/grok-4.1-fast
# MiniMax M2.5 is used automatically for full_llm tier (insights, weekly reviews)
# and as the default agent model for code, analyst, and general agents.
# Override: OPENROUTER_MODEL=minimax/minimax-m2.5 to use it globally.

# Email (SMTP - Required for magic links)
# ----------------------------------------
# Any SMTP provider works: Fastmail, Postmark, Resend, Mailgun, your own host.
# Magic links are the ONLY way into the app, so without this nobody can log in.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=brain@example.com
SMTP_PASS=your-email-password
SMTP_FROM=brain@example.com
SMTP_FROM_NAME=Brain Portal

# App Configuration (Required)
# ----------------------------
# Development: http://localhost:3000
# Production: Your Vercel URL (e.g., https://brain-portal.vercel.app)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# The address every emailed link points at (magic links, task alerts, digests,
# quick-action buttons). Read at runtime, so it works without a rebuild, which
# NEXT_PUBLIC_APP_URL does not. Optional on Vercel: production deploys fall back
# to VERCEL_PROJECT_PRODUCTION_URL. A localhost value is ignored in production.
# APP_URL=https://your-app.example.com

# Signs the one-tap buttons in notification emails (Mark done, Tomorrow,
# Snooze, Unsubscribe). Optional: falls back to SESSION_SECRET. Rotating it
# invalidates every button in already-sent emails.
# EMAIL_ACTION_SECRET=generate-with-openssl-rand-hex-32

# Session Secret (Required)
# -------------------------
# Generate with: openssl rand -hex 32
SESSION_SECRET=generate-a-random-64-character-hex-string-here

# Cloudflare R2 Storage (Required for file uploads)
# --------------------------------------------------
# 1. Create R2 bucket in Cloudflare dashboard
# 2. Generate R2 API token with read/write permissions
# 3. Configure custom domain or use R2.dev URL
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=brain-portal-files
R2_PUBLIC_URL=https://files.yourdomain.com

# Scheduled Jobs (Required in production)
# ----------------------------------------
# Every /api/cron/* route is guarded by this shared secret. If it is NOT set in
# production, `verifyCronSecret` answers every scheduled request with 401 — the
# agent queue is never drained, notes are never indexed, and delegated AI work
# sits in 'queued' forever with no error to show for it. The header in the
# System status panel reports exactly this condition.
#
# Generate with: openssl rand -hex 32
# Vercel Cron sends it automatically as `Authorization: Bearer $CRON_SECRET`
# once the variable exists in the project's environment.
CRON_SECRET=generate-a-random-64-character-hex-string-here

# Model overrides (Optional)
# ---------------------------
# Models are normally chosen in Settings → AI Models, which lists what
# OpenRouter currently offers and validates the choice against it. These
# variables pin a default for deployments that would rather set it here.
#
# A choice saved in Settings outranks these, and any id OpenRouter no longer
# lists is skipped in favour of the next candidate — so a retired model
# degrades instead of breaking a feature.
# OPENROUTER_MODEL=x-ai/grok-4.1-fast
# OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Who may create an account (Optional, defaults to closed)
# --------------------------------------------------------
# Magic-link auth will happily create an account for ANY address that receives
# a link, so an instance with SMTP configured and no policy here is an open
# signup: anyone gets a workspace and a share of your OpenRouter bill.
#
#   closed     (default) Only addresses already in the `users` table can sign
#              in. Create the first one with: npm run user:create you@example.com
#   allowlist  Addresses in ALLOWED_EMAILS may sign up. Entries may be a full
#              address, or "@yourdomain.com" to admit a whole domain.
#   open       Anyone may sign up. Only for a deliberately public service.
#
# Existing users can always sign in, whatever this is set to.
SIGNUP_MODE=closed
# ALLOWED_EMAILS=you@example.com,@yourcompany.com

# Admin accounts (Optional)
# --------------------------
# Comma-separated. Grants access to /api/admin/*. With this unset, nobody is an
# admin — there is deliberately no implicit "first user is admin" rule.
# ADMIN_EMAILS=you@example.com

# Trusting proxy headers (Optional, defaults to true)
# ---------------------------------------------------
# Rate limiting keys off `x-forwarded-for`. Behind Vercel, Cloudflare or an
# nginx that overwrites it, that is trustworthy. If Node is directly exposed to
# the internet, the header is attacker-controlled and every rate limit becomes
# bypassable — set this to false, which falls back to one shared bucket.
# TRUST_PROXY_HEADERS=true

# External sync endpoint (Optional, disabled by default)
# -------------------------------------------------------
# Enables GET/POST /api/brain for an external sync agent. BOTH must be set or
# the endpoint answers 503. There is deliberately no default account.
#
# Prefer the MCP transport at /api/mcp/rpc for anything non-trivial: its keys
# are per-user, scoped and rate-limited. Generate one in Settings → AI API
# access, or with: npm run mcp:keygen -- you@example.com "Agent key"
# BRAIN_SERVICE_TOKEN=generate-a-random-64-character-hex-string-here
# BRAIN_SERVICE_EMAIL=you@example.com
